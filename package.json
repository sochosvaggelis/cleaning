{
  "name": "cleanup-company",
  "version": "1.0.0",
  "private": true,
  "description": "Cleanup Co. pressure-washing website: 3D scroll story, price list and online booking.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^5.2.1",
    "nodemailer": "^10.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "three": "^0.186.1",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
