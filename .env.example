# Copy to .env and fill in. Never commit the real .env.

# Password for the booking dashboard at /admin (required to enable it)
ADMIN_PASSWORD=choose-a-long-password
# Random string used to sign admin logins, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# API port (the Vite dev server proxies /api to it)
PORT=3001

# Your time zone, e.g. America/New_York, Europe/London (defaults to the server's)
BUSINESS_TIMEZONE=

# Public address of the site, used for links in emails (e.g. https://cleanupco.com)
PUBLIC_URL=

# Email (optional). Without SMTP the emails are printed in the server console.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Google "app password">
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where new-booking notifications go (defaults to the email in shared/business.js)
NOTIFY_EMAIL=
